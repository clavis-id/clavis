{
    "alias": "clavis",
    "description": "Clavis, default tenant",
    "server": {
        "discoveryUrl": "https://clavis.test/.well-known/openid-configuration"
    },
    "client": {
        "client_id": "conformance-1",
        "client_secret": "${CLIENT_SECRET_1}"
    },
    "client2": {
        "client_id": "conformance-2",
        "client_secret": "${CLIENT_SECRET_2}"
    },
    "client_secret_post": {
        "client_id": "conformance-1",
        "client_secret": "${CLIENT_SECRET_1}"
    },
    "browser": [
        {
            "match": "https://clavis.test/oauth2/authorize*",
            "tasks": [
                {
                    "task": "Login",
                    "optional": true,
                    "match": "https://clavis.test/login*",
                    "commands": [
                        [
                            "text",
                            "id",
                            "email",
                            "${USER_EMAIL}"
                        ],
                        [
                            "text",
                            "id",
                            "password",
                            "${USER_PASSWORD}"
                        ],
                        [
                            "click",
                            "id",
                            "submit"
                        ]
                    ]
                },
                {
                    "task": "Consent",
                    "optional": true,
                    "match": "https://clavis.test/consent*",
                    "commands": [
                        [
                            "click",
                            "id",
                            "allow"
                        ]
                    ]
                },
                {
                    "task": "Verify Complete",
                    "match": "*/test/*/callback*",
                    "commands": [
                        [
                            "wait",
                            "id",
                            "submission_complete",
                            10
                        ]
                    ]
                }
            ]
        },
        {
            "match": "https://clavis.test/oauth2/logout*",
            "tasks": [
                {
                    "task": "Sign out",
                    "match": "https://clavis.test/oauth2/logout*",
                    "commands": [
                        [
                            "click",
                            "id",
                            "logout"
                        ],
                        [
                            "wait",
                            "contains",
                            "post_logout_redirect",
                            10
                        ]
                    ]
                }
            ]
        }
    ],
    "override": {
        "oidcc-prompt-login": {
            "browser": [
                {
                    "comment": "updates the placeholder with the login page of the second authorization",
                    "match": "https://clavis.test/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Login",
                            "optional": true,
                            "match": "https://clavis.test/login*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Sign in",
                                    "update-image-placeholder-optional"
                                ],
                                [
                                    "text",
                                    "id",
                                    "email",
                                    "${USER_EMAIL}"
                                ],
                                [
                                    "text",
                                    "id",
                                    "password",
                                    "${USER_PASSWORD}"
                                ],
                                [
                                    "click",
                                    "id",
                                    "submit"
                                ]
                            ]
                        },
                        {
                            "task": "Consent",
                            "optional": true,
                            "match": "https://clavis.test/consent*",
                            "commands": [
                                [
                                    "click",
                                    "id",
                                    "allow"
                                ]
                            ]
                        },
                        {
                            "task": "Verify Complete",
                            "match": "*/test/*/callback*",
                            "commands": [
                                [
                                    "wait",
                                    "id",
                                    "submission_complete",
                                    10
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
