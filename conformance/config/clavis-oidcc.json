        "oidcc-ensure-registered-redirect-uri": {
            "browser": [
                {
                    "comment": "expects the error page for an unregistered redirect URI",
                    "match": "https://clavis.test/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect the error page",
                            "match": "https://clavis.test/oauth2/authorize*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*",
                                    10,
                                    "Invalid sign-in request",
                                    "update-image-placeholder"
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-request-object-with-redirect-uri": {
            "browser": [
                {
                    "comment": "expects the error page for the invalid redirect URI outside the unsupported request object",
